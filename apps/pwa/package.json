    "@loomrealm/platform-ports": "0.1.0-alpha.0",
    "@loomrealm/realm-state": "0.1.0-alpha.0",
    "@loomrealm/renderer": "0.1.0-alpha.0",
    "@loomrealm/subsystem": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@loomrealm/desktop": "0.1.0-alpha.0",
    "@loomrealm/game-launcher-hostra": "0.1.0-alpha.0",
