    "@loomrealm/platform-ports": "0.1.0-alpha.0",
    "@loomrealm/renderer": "0.1.0-alpha.0",
    "@loomrealm/renderer-control": "0.1.0-alpha.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@loomrealm/subsystem": "0.1.0-alpha.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "electron": "44.3.0",
    "esbuild": "0.25.9",
