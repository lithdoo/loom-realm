{
  "name": "@loomrealm-game/common-controls",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser/device-input.browser.js": "./dist/browser/device-input.browser.js"
  },
  "files": ["dist/"],
  "sideEffects": ["./dist/browser/device-input.browser.js"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && node scripts/build-browser.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  }
}
