{
  "name": "loom-realm-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspaces --if-present",
    "test:packages": "npm test --workspaces --if-present",
    "test:core-packages": "npm test -w @loomrealm/foundation -w @loomrealm/wire",
    "test:game-package": "npm test -w @loomrealm/wire -w @loomrealm/game-package",
    "test:runtime-control": "npm test -w @loomrealm/foundation -w @loomrealm/wire -w @loomrealm/runtime-control",
    "test:data": "npm test -w @loomrealm/foundation -w @loomrealm/wire -w @loomrealm/data",
    "test:m8": "npm run build:packages && npm test -w @loomrealm/platform-ports -w @loomrealm/data -w @loomrealm/subsystem -w @loomrealm/renderer-control -w @loomrealm/renderer -w @loomrealm/main && npm run test:game-launcher-hostra",
    "test:m7": "npm run build -w @loomrealm/foundation -w @loomrealm/wire -w @loomrealm/platform-ports -w @loomrealm/data -w @loomrealm/renderer-control -w @loomrealm/renderer && npm run build:packages && npm test -w @loomrealm/platform-ports -w @loomrealm/renderer-control -w @loomrealm/renderer -w @loomrealm/main && npm run test:game-launcher-hostra",
    "test:game-launcher-hostra": "npm run build -w @loomrealm/foundation -w @loomrealm/wire -w @loomrealm/game-package -w @loomrealm/platform-ports -w @loomrealm/runtime-control -w @loomrealm/renderer-control -w @loomrealm/data -w @loomrealm/subsystem -w @loomrealm/main && npm test -w @loomrealm/game-launcher-hostra",
    "test:fixtures": "npm run build -w @loomrealm/fsdb-http && node --test tools/fixtures/**/*.test.mjs",
    "docs:dev": "vitepress dev doc",
    "docs:build": "vitepress build doc",
    "docs:preview": "vitepress preview doc",
    "docs:check-links": "node scripts/run-python.mjs scripts/check-doc-links.py"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "yauzl": "3.2.0"
  }
}
